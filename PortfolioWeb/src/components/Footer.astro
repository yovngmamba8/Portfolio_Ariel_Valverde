---
const year = new Date().getFullYear();
---

<footer class="border-t border-border px-6 py-6 md:px-12 transition-colors duration-300">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="font-mono text-sm text-text-muted">
      <span class="text-green-500">ariel@portfolio</span>
      <span>:</span>
      <span class="text-accent">~</span>
      <span>$</span>
      <span class="ml-1" data-i18n="footer.echo">echo "Hecho con ❤️ y Astro"</span>
    </div>
    <p class="font-mono text-xs text-text-muted">
      &copy; {year} <span data-i18n="footer.copyright">Ariel Valverde. Todos los derechos reservados.</span>
    </p>
  </div>
</footer>
