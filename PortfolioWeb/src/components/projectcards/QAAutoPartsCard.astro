---
import GitHubIcon from "../icons/GitHubIcon.astro";
---

<div
  class="flex flex-col bg-bg-card border border-border rounded-xl p-6 hover:bg-bg-card-hover hover:border-border-hover transition-all group"
>
    <h3 class="text-xl font-semibold text-text-primary mb-2" data-i18n="projects.qaAutoparts.title">QA AutoParts - Plan de Pruebas</h3>
    <p class="text-text-secondary mb-4 flex-1 text-sm leading-relaxed" data-i18n="projects.qaAutoparts.description">
        Plan de pruebas integral para la plataforma AutoParts, incluyendo pruebas funcionales, de rendimiento y seguridad.
    </p>
    
    <div class="flex items-center gap-4 mb-6">
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/selenium/selenium-original.svg" alt="Selenium" title="Selenium" class="w-8 h-8 hover:scale-110 transition-transform duration-300" />
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" alt="Python" title="Python" class="w-8 h-8 hover:scale-110 transition-transform duration-300" />
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/pytest/pytest-plain.svg" alt="Pytest" title="Pytest" class="w-8 h-8 hover:scale-110 transition-transform duration-300" />
    </div>
    
    <a href="https://github.com/yovngmamba8/plan-pruebas-autoparts" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent hover:text-accent-hover font-medium transition-colors mt-auto text-sm">
        <GitHubIcon class="w-5 h-5" />
        <span data-i18n="projects.qaAutoparts.link">Ver Documentación</span>
    </a>
</div>
