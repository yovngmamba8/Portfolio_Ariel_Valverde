---
import GitHubIcon from "../icons/GitHubIcon.astro";
---

<div
  class="flex flex-col bg-bg-card border border-border rounded-xl p-6 hover:bg-bg-card-hover hover:border-border-hover transition-all group"
>
    <h3 class="text-xl font-semibold text-text-primary mb-2" data-i18n="projects.autoparts.title">AutoParts - E-commerce</h3>
    <p class="text-text-secondary mb-4 flex-1 text-sm leading-relaxed" data-i18n="projects.autoparts.description">
        Plataforma e-commerce de repuestos automotrices con carrito de compras, autenticación de usuarios y panel de administración.
    </p>
    
    <div class="flex items-center gap-4 mb-6">
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/django/django-plain.svg" alt="Django" title="Django" class="w-8 h-8 hover:scale-110 transition-transform duration-300 bg-white/90 rounded-sm p-1" />
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" alt="Python" title="Python" class="w-8 h-8 hover:scale-110 transition-transform duration-300" />
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" alt="JavaScript" title="JavaScript" class="w-8 h-8 hover:scale-110 transition-transform duration-300 rounded-sm" />
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg" alt="CSS3" title="CSS3" class="w-8 h-8 hover:scale-110 transition-transform duration-300" />
    </div>
    <a href="https://github.com/yovngmamba8/autoparts" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent hover:text-accent-hover font-medium transition-colors mt-auto text-sm">
        <GitHubIcon class="w-5 h-5" />
        <span data-i18n="projects.autoparts.link">Ver Proyecto en GitHub</span>
    </a>
</div>
