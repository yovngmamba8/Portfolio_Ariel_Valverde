---
<button
  class="theme-toggle p-2 rounded-lg border border-border hover:bg-bg-card-hover transition-colors cursor-pointer"
  aria-label="Toggle theme"
>
  <svg class="icon-sun w-5 h-5 text-text-secondary hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
  </svg>
  <svg class="icon-moon w-5 h-5 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
  </svg>
</button>

<script>
  function setupThemeToggles() {
    const toggles = document.querySelectorAll('.theme-toggle');
    const iconsSun = document.querySelectorAll('.icon-sun');
    const iconsMoon = document.querySelectorAll('.icon-moon');

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      if (theme === 'dark') {
        iconsSun.forEach(icon => icon.classList.remove('hidden'));
        iconsMoon.forEach(icon => icon.classList.add('hidden'));
      } else {
        iconsSun.forEach(icon => icon.classList.add('hidden'));
        iconsMoon.forEach(icon => icon.classList.remove('hidden'));
      }
    }

    // Initialize: check localStorage, then system preference
    const saved = localStorage.getItem('theme');
    if (saved) {
      setTheme(saved);
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      setTheme('dark');
    } else {
      setTheme('light');
    }

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
      });
    });
  }

  // Run on load
  setupThemeToggles();
</script>
