---
import AutoPartsCard from "./projectcards/AutoPartsCard.astro";
import QAAutoPartsCard from "./projectcards/QAAutoPartsCard.astro";
import PortfolioWebCard from "./projectcards/PortfolioWebCard.astro";
import FinanceAppCard from "./projectcards/FinanceAppCard.astro";
---

<section id="proyectos" class="mt-20">
  <h2
    class="text-3xl font-bold text-text-primary mb-6 flex items-center gap-3"
    data-i18n="projects.title"
  >
    Proyectos Destacados
  </h2>

  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
    <FinanceAppCard />
    <AutoPartsCard />
    <QAAutoPartsCard />
    <PortfolioWebCard />
  </div>
</section>
