---
import { Image } from "astro:assets";
import FotoPortfolio from "../assets/FotoPortfolio.png";
import TechStack from "./TechStack.astro";

import GitHubIcon from "./icons/GitHubIcon.astro";
---

<section class="flex flex-col md:flex-row items-center justify-between gap-12">
  <div class="flex-1 space-y-6 text-left">
    <div class="flex items-center gap-6 pt-4">
      <p
        class="text-3xl font-medium text-text-secondary m-0"
        data-i18n="hero.greeting"
      >
        Hola, soy Ariel Valverde 👋
      </p>
      <a
        href="https://github.com/yovngmamba8"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <GitHubIcon
          class="w-8 h-8 text-text-secondary hover:text-accent transition-colors duration-300"
        />
      </a>
    </div>

    <h1
      class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-text-primary leading-tight"
    >
      <span data-i18n="hero.titleLine1">Desarrollador Web</span>
      <br />
      <span data-i18n="hero.titleLine2">Full Stack</span>
      <br />
      <span class="text-accent" data-i18n="hero.titleAccent"
        >y Calidad de Software</span
      >
      <TechStack />
    </h1>

    <p class="text-xl text-text-secondary max-w-lg pb-2">
      <span data-i18n="hero.description"
        >Desarrollador Web Full Stack orientado al Front End</span
      >
      <span data-i18n="hero.descriptionEnd"
        >y Calidad de Software, apasionado por crear soluciones innovadoras y
        eficientes. Siempre buscando aprender nuevas tecnologías y mejorar mis
        habilidades. ¡Bienvenido a mi portfolio!</span
      >
    </p>

    <a
      href="/CV_Ariel_Valverde.pdf"
      download
      class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-[var(--bg-main)] bg-accent hover:bg-accent-hover rounded-lg transition-colors duration-300"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"
        ></path>
      </svg>
      <span data-i18n="hero.downloadCV">Descargar CV</span>
    </a>
  </div>

  <div class="flex-1 flex justify-center md:justify-end">
    <Image
      src={FotoPortfolio}
      alt="Foto de Ariel Valverde"
      class="w-80 h-80 object-cover rounded-full shadow-lg"
    />
  </div>
</section>
