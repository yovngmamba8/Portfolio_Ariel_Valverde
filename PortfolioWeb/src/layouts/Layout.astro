---
import "../styles/global.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio de Ariel Valverde - Desarrollador Web Full Stack y Calidad de Software" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body
    class="min-h-screen bg-bg-body px-4 py-8 md:py-12"
  >
    <div
      class="w-full max-w-7xl mx-auto bg-bg-main rounded-2xl shadow-2xl border border-border transition-colors duration-300"
    >
      <div
        class="bg-bg-header px-4 py-3 border-b border-border flex gap-2 transition-colors duration-300"
      >
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      </div>
      <div class="p-4 md:p-0">
        <slot />
      </div>
    </div>
  </body>
</html>


